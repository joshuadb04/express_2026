### Post login
# @name login
POST http://localhost:3000/api/v1/auth/login
content-type: application/json

{
  "username": "johnpork",
  "password": "passingtheword"
}

### Get my user info
GET http://localhost:3000/api/v1/auth/me
Authorization: Bearer {{login.response.body.token}}

### Get all cats
GET http://127.0.0.1:3000/api/v1/cats

### Get cat by ID
GET http://127.0.0.1:3000/api/v1/cats/44

### Get cats by user ID
GET http://127.0.0.1:3000/api/v1/cats/user/45

### Add cat //this no longer works in newer API changes
POST http://127.0.0.1:3000/api/v1/cats
Content-Type: application/json

{
  "cat_name": "Puff",
  "weight": 5,
  "owner": 3552,
  "filename": "puff.jpg",
  "birthdate": "2023-12-12"
}

### Update cat
PUT http://127.0.0.1:3000/api/v1/cats/53
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "weight": 2
}

### Delete cat
DELETE  http://127.0.0.1:3000/api/v1/cats/51
Authorization: Bearer {{login.response.body.token}}

### Get all users
GET http://127.0.0.1:3000/api/v1/users

### Get user by ID
GET http://127.0.0.1:3000/api/v1/users/45

### Add user
POST http://127.0.0.1:3000/api/v1/users
Content-Type: application/json

{
  "name": "deleteme",
  "username": "deleteme",
  "email": "jp@metropolia.fi",
  "role": "staff",
  "password": "passingtheword"
}

### Update user
PUT http://127.0.0.1:3000/api/v1/users/50
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "role": "testuser"
}

### Delete user
DELETE  http://127.0.0.1:3000/api/v1/users/51
Authorization: Bearer {{login.response.body.token}}